# Copy this file to .env and fill in your own values:  cp .env.example .env

# --- Database and auth ---
# PostgreSQL connection string (local Postgres, Neon or Supabase)
DATABASE_URL="postgresql://postgres:your-password@localhost:5432/cinestream?schema=public"
# Any long random string, e.g. output of: openssl rand -base64 32
BETTER_AUTH_SECRET="your-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# --- TMDB (create a free account at themoviedb.org > Settings > API) ---
# Use the "API Read Access Token" (the long Bearer token), not the short API key.
NEXT_PUBLIC_TMDB_BASE_URL="https://api.themoviedb.org"   # use https://api.tmdb.org if blocked on your network
NEXT_PUBLIC_ACCESS_TOKEN="your-tmdb-bearer-token"
ACCESS_TOKEN="your-tmdb-bearer-token"

# --- MyAnimeList (create a client ID at myanimelist.net > Profile > API) ---
CILENTID="your-mal-client-id"
NEXT_PUBLIC_MAL_CLIENT_ID="your-mal-client-id"

# --- Optional: Google sign-in (leave blank to use email/password login only) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
